# =============================================================================
# dpc-bench LLM credentials
# Copy to .env and fill in. Never commit real keys.
# =============================================================================

# --- Recommended: memtensor OpenAI-compatible Chat Completions ---
# Matches: POST {MODEL_gpt_memtensor_URL}/chat/completions
DPC_BENCH_LLM_BACKEND=memtensor
# Use /v1 so POST becomes .../v1/chat/completions (not the HTML portal)
MODEL_gpt_memtensor_URL=https://api-int.memtensor.cn/v1
MODEL_gpt_memtensor_KEY=
GPT_API_MODEL=gpt-4o-2024-11-20
DPC_BENCH_LLM_TIMEOUT_S=120

# Optional aliases (if set, override GPT_API_MODEL / timeout above)
# DPC_BENCH_LLM_MODEL=
# DPC_BENCH_LLM_BASE_URL=   # usually leave empty; use MODEL_gpt_memtensor_URL
# DPC_BENCH_LLM_API_KEY=    # usually leave empty; use MODEL_gpt_memtensor_KEY

# --- Multi-model sweep: put vendor keys here, reference from models.yaml ---
# OPENAI_API_KEY=
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_COMPAT_API_KEY=
# GEMINI_API_KEY=

# --- Optional: company Gateway Responses API (model.memtensor.cn) ---
# DPC_BENCH_LLM_BACKEND=gateway
# MODEL_gateway_gpt_URL=http://model.memtensor.cn/api/external/v1
# MODEL_gateway_gpt_KEY=
# MODEL_gateway_gpt_TASK_TYPE=dpc_bench
# MODEL_gateway_gpt_CREATED_BY=your-name
# MODEL_gateway_gpt_TASK_LEVEL=demo
# MODEL_gateway_gpt_TOKEN_STAT_MODE=b
